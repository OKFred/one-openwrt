+func candidateWorker(t *testing.T) (*worker, *candidateLogger) {
+	t.Helper()
+	logger := &candidateLogger{}
+	w, err := newWorker(workerConfig{ID: 0, Logger: logger, Ruleset: candidateRules{}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return w, logger
+}
+
+func candidateFlow() gopacket.Flow {
+	return gopacket.NewFlow(layers.EndpointIPv4, net.ParseIP("192.0.2.1").To4(), net.ParseIP("198.51.100.1").To4())
+}
+
+func candidateTCP(port uint16) *layers.TCP {
+	packet := &layers.TCP{SrcPort: layers.TCPPort(port), DstPort: 443, SYN: true, Seq: 1000}
+	packet.SetInternalPortsForTesting()
+	return packet
+}
+
+// Reflection only observes exact-version internals in tests, never production.
+func candidatePoolCount(w *worker) int {
+	return reflect.ValueOf(w.tcpStreamPool).Elem().FieldByName("conns").Len()
+}
+
+func candidateFreeStreams(w *worker) int {
+	free := reflect.ValueOf(w.tcpStreamPool).Elem().FieldByName("free")
+	retained := 0
+	for i := 0; i < free.Len(); i++ {
+		conn := free.Index(i).Elem()
+		for _, direction := range []string{"c2s", "s2c"} {
+			if !conn.FieldByName(direction).FieldByName("stream").IsNil() {
+				retained++
+			}
+		}
+	}
+	return retained
+}
