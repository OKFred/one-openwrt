+func TestCandidateFeedCancellationUnblocksFullQueue(t *testing.T) {
+	w := &worker{packetChan: make(chan *workerPacket, 1)}
+	w.packetChan <- &workerPacket{}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan bool, 1)
+	started := make(chan struct{})
+	go func() { close(started); done <- w.Feed(ctx, &workerPacket{}) }()
+	<-started
+	select {
+	case <-done:
+		t.Fatal("full queue unexpectedly accepted a packet before cancellation")
+	case <-time.After(10 * time.Millisecond):
+	}
+	cancel()
+	select {
+	case accepted := <-done:
+		if accepted {
+			t.Fatal("canceled full-queue send succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("Feed remained blocked after cancellation")
+	}
+}
