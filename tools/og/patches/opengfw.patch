+func TestCandidateTickExpiresFlowWithoutNewPackets(t *testing.T) {
+	w, _ := candidateWorker(t)
+	closed := make(chan struct{}, 1)
+	w.tcpStreamPool = reassembly.NewStreamPool(candidateObservedFactory{closed: closed})
+	w.tcpAssembler = reassembly.NewAssembler(w.tcpStreamPool)
+	ctxOld := &tcpContext{PacketMetadata: &gopacket.PacketMetadata{CaptureInfo: gopacket.CaptureInfo{Timestamp: time.Now().Add(-tcpIdleTimeout - time.Second)}}}
+	w.tcpAssembler.AssembleWithContext(candidateFlow(), candidateTCP(40000), ctxOld)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() { w.Run(ctx); close(done) }()
+	select {
+	case <-closed:
+	case <-time.After(tcpCleanupInterval + 2*time.Second):
+		cancel()
+		<-done
+		t.Fatal("idle flow was not cleaned by tick without another packet")
+	}
+	cancel()
+	<-done
+	if candidatePoolCount(w) != 0 || candidateFreeStreams(w) != 0 {
+		t.Fatal("tick left an entry or free-list stream reference")
+	}
+}
