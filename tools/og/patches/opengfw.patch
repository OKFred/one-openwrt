+func TestCandidateTTLReclaimsFinalFlowsAndRetainsFreshFlow(t *testing.T) {
+	w, logger := candidateWorker(t)
+	now := time.Now()
+	for i := 0; i < 1000; i++ {
+		metadata := &gopacket.PacketMetadata{CaptureInfo: gopacket.CaptureInfo{Timestamp: now.Add(-tcpIdleTimeout - time.Second)}}
+		if verdict := w.handleTCP(candidateFlow(), metadata, candidateTCP(uint16(40000+i))); verdict != io.VerdictAcceptStream {
+			t.Fatalf("old stream verdict: %v", verdict)
+		}
+	}
+	fresh := &gopacket.PacketMetadata{CaptureInfo: gopacket.CaptureInfo{Timestamp: now}}
+	w.handleTCP(candidateFlow(), fresh, candidateTCP(50000))
+	beforeActions := logger.actions.Load()
+	w.tcpAssembler.FlushCloseOlderThan(now.Add(-tcpIdleTimeout))
+	if got := candidatePoolCount(w); got != 1 {
+		t.Fatalf("pool count=%d, want only one fresh stream", got)
+	}
+	if got := candidateFreeStreams(w); got != 0 {
+		t.Fatalf("free list retains %d stream references", got)
+	}
+	if logger.actions.Load() != beforeActions {
+		t.Fatal("expiration duplicated final actions")
+	}
+	w.tcpAssembler.FlushAll()
+	if candidatePoolCount(w) != 0 || candidateFreeStreams(w) != 0 {
+		t.Fatal("final cleanup retained pool entries or stream references")
+	}
+}
