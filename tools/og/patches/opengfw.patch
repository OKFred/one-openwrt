+func TestCandidateEngineShutdownWaitsForCleanupWithoutNewPackets(t *testing.T) {
+	w, logger := candidateWorker(t)
+	w.handleTCP(candidateFlow(), &gopacket.PacketMetadata{}, candidateTCP(40000))
+	e := &engine{workers: []*worker{w}, io: candidateIO{}}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := e.Run(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if logger.stops.Load() != 1 || candidatePoolCount(w) != 0 || candidateFreeStreams(w) != 0 {
+		t.Fatal("Engine.Run returned before worker cleanup completed")
+	}
+}
