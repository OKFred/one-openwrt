+func TestCandidateNilContextAndFinalReplay(t *testing.T) {
+	for _, ac := range []reassembly.AssemblerContext{nil, (*tcpContext)(nil), &tcpContext{Verdict: tcpVerdictAccept}} {
+		logger := &candidateLogger{}
+		s := &tcpStream{virgin: true, logger: logger, ruleset: candidateRules{}, info: ruleset.StreamInfo{Props: make(analyzer.CombinedPropMap)}}
+		s.ReassembledSG(candidateEmptySG{}, ac)
+		if s.lastVerdict != tcpVerdictAcceptStream || logger.actions.Load() != 1 {
+			t.Fatal("first no-analyzer packet must still match rules")
+		}
+		oldContext := &tcpContext{Verdict: tcpVerdictDropStream}
+		s.ReassembledSG(nil, nil)
+		s.ReassembledSG(nil, oldContext)
+		if logger.actions.Load() != 1 || oldContext.Verdict != tcpVerdictDropStream {
+			t.Fatal("final replay reanalyzed or overwrote old context")
+		}
+		if s.Accept(nil, gopacket.CaptureInfo{}, reassembly.TCPDirClientToServer, 0, nil, ac) {
+			t.Fatal("final stream unexpectedly accepted another packet")
+		}
+	}
+}
