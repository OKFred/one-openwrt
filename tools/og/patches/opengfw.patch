+func TestCandidateDispatchTimestampsAndZeroMetadataFallback(t *testing.T) {
+	w, _ := candidateWorker(t)
+	e := &engine{workers: []*worker{w}}
+	ip := &layers.IPv4{Version: 4, TTL: 64, Protocol: layers.IPProtocolTCP, SrcIP: net.ParseIP("192.0.2.1").To4(), DstIP: net.ParseIP("198.51.100.1").To4()}
+	tcp := candidateTCP(40000)
+	if err := tcp.SetNetworkLayerForChecksum(ip); err != nil {
+		t.Fatal(err)
+	}
+	buffer := gopacket.NewSerializeBuffer()
+	if err := gopacket.SerializeLayers(buffer, gopacket.SerializeOptions{FixLengths: true, ComputeChecksums: true}, ip, tcp); err != nil {
+		t.Fatal(err)
+	}
+	before := time.Now()
+	if !e.dispatch(context.Background(), candidatePacket(buffer.Bytes())) {
+		t.Fatal("dispatch rejected valid packet")
+	}
+	wPkt := <-w.packetChan
+	stamp := wPkt.Packet.Metadata().Timestamp
+	if stamp.IsZero() || stamp.Before(before) || stamp.After(time.Now()) {
+		t.Fatalf("invalid dispatch timestamp: %v", stamp)
+	}
+	metadata := &gopacket.PacketMetadata{}
+	w.handleTCP(candidateFlow(), metadata, candidateTCP(40001))
+	if metadata.Timestamp.IsZero() {
+		t.Fatal("zero timestamp fallback was not applied")
+	}
+	w.handleTCP(candidateFlow(), nil, candidateTCP(40002))
+	w.tcpAssembler.FlushAll()
+}
